# Port the API server listens on. Defaults to 5000 if unset.
PORT=5000

# Secret used to sign JWTs. Required in any real deployment - the app falls
# back to an insecure development default (with a startup warning) if unset,
# so it still runs zero-config for local demos.
JWT_SECRET=

# Optional. When set, GET /api/hospitals/nearby returns real nearby hospitals
# from the Google Places API. Without it, the endpoint falls back to bundled
# mock hospitals sorted by real distance.
GOOGLE_MAPS_API_KEY=

# Optional. When set, all data (users, vitals, hospitals, appointments,
# patients) persists in MongoDB instead of the in-memory store, and survives
# restarts. Get a free connection string from MongoDB Atlas. Without it, the
# app runs on the in-memory store with the same seed data - no setup needed.
MONGODB_URI=
